# ── Copy this file to .env and fill in all values ────────────────────────

# Application
DEBUG=true
SECRET_KEY=d+nR1lp7krPDA3nE8zl3EwtHn+YXEY+x7voZWeVPIMhjzBIRUS313dk4PZaGtEBv

# Database (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://neonexus_user:neonexus_dev_password@127.0.0.1:55443/copilit
DB_AUTO_CREATE_ON_STARTUP=false

# CORS — comma-separated list of allowed origins
# Add your admin panel's production URL here
CORS_ORIGINS=["http://localhost:3001","http://localhost:5173","http://127.0.0.1:5173","file://"]

# File storage — absolute path on the VPS where .mp4 files are saved
VIDEO_STORAGE_PATH=C:\Users\ASUS\Desktop\neonexus-copilot\neonexus-copilot\local_videos

# Max upload size in MB (4096 = 4 GB)
MAX_UPLOAD_SIZE_MB=4096

# ── AI API Keys ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=NeoNexus Copilot
OPENROUTER_HTTP_TIMEOUT_SEC=8
LIVE_RESPONSE_TIMEOUT_SEC=4
TRANSCRIBE_HTTP_TIMEOUT_SEC=6

# Optional if using direct providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# ── AI Model overrides (optional) ────────────────────────────────────────
LIVE_LLM_PROVIDER=openrouter
SUMMARY_LLM_PROVIDER=openrouter

CLAUDE_MODEL=claude-sonnet-4-20250514
OPENROUTER_LIVE_MODEL=openai/gpt-4o
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENROUTER_SUMMARY_MODEL=openai/gpt-4o-mini
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENCODING=linear16
DEEPGRAM_SAMPLE_RATE=16000
